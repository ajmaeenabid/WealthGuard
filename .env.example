# Copy this file to .env and fill in your key. .env is git-ignored and never uploaded.
# Real environment variables override this file. No quotes needed. Put comments on their own lines.

# Which provider answers: groq or anthropic (if empty: Anthropic when its key exists, else Groq)
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Uncomment to force the offline mock (deterministic canned answers):
# USE_MOCK_LLM=1

# Optional: Qdrant Cloud as the vector database (free cluster). https URL of your cluster, REST port 6333.
# If empty, the built-in local vector index is used.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=wealthguard_kb

# Optional: key that seals advice receipts (HMAC). If empty, a random key is stored with the database.
# Set it (any long random string) so receipts stay verifiable across restarts and on Vercel.
RECEIPT_KEY=

# Optional: Whisper speech-to-text for the microphone. Default: Groq's hosted Whisper when GROQ_API_KEY is set.
# WHISPER_PROVIDER: groq (default), local (faster-whisper on this machine, pip install faster-whisper) or off.
# WHISPER_MODEL: groq default whisper-large-v3-turbo (or whisper-large-v3); local default base (tiny, small, ...).
WHISPER_PROVIDER=
WHISPER_MODEL=

# ---- Personal finance assistant (uses GROQ_API_KEY above; the key never leaves the server) ----
# Model for understanding messages and explaining reports. Default openai/gpt-oss-20b (structured JSON output, 131k context).
FINANCE_MODEL=openai/gpt-oss-20b
# Request timeout in seconds, retries on 429/5xx/timeouts (exponential backoff with jitter, Retry-After honoured),
# concurrent calls, calls per minute (the documented Developer-plan limit for this model is 30/min; stay below your own limit),
# and the longest wait for a rate-limit reset before the app falls back to its built-in rules.
FIN_AI_TIMEOUT=30
FIN_AI_MAX_RETRIES=3
FIN_AI_CONCURRENCY=2
FIN_AI_RPM=20
FIN_AI_MAX_WAIT=20
# low (default), medium or high reasoning effort for gpt-oss
FIN_REASONING_EFFORT=low
# USD per million tokens used for the cost estimate (defaults are the Groq prices checked on 2026-10-19; your invoice is authoritative)
GROQ_PRICE_INPUT_PER_M=0.075
GROQ_PRICE_OUTPUT_PER_M=0.30
# Time zone for "today", "yesterday" and stored transaction dates (default Asia/Dhaka)
FIN_TZ=Asia/Dhaka

# ---- Storage, sign-in and startup validation ----
# Path of the SQLite file (default ./wealthguard.db). On Vercel use /tmp/wealthguard.db (the filesystem is ephemeral there).
# WEALTHGUARD_DB=
# 0 switches sign-in OFF. For tests only; never set it in production.
# WEALTHGUARD_AUTH=1
# 1 stops the app reading this .env file (tests).
# WEALTHGUARD_NO_DOTENV=0
# 1 makes an invalid value above stop the server at startup (values are never printed). Check with: python scripts/check_env.py
# WEALTHGUARD_STRICT_CONFIG=0

# Prompt budget: requests are trimmed to this many (estimated) input tokens; replies are capped at the output limit.
# FIN_AI_MAX_INPUT_TOKENS=3500
# FIN_AI_MAX_OUTPUT_TOKENS=1200

# Hard time limits for one AI call (retries included), in seconds. After this the chat shows a notice instead of waiting.
# FIN_AI_DEADLINE=25
# WEALTHGUARD_LLM_DEADLINE=30
