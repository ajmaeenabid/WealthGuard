# Copy this file to .env and fill in your key. .env is git-ignored and never uploaded.
# Real environment variables override this file. No quotes needed. Put comments on their own lines.

# Which provider answers: groq or anthropic (if empty: Anthropic when its key exists, else Groq)
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Uncomment to force the offline mock (deterministic canned answers):
# USE_MOCK_LLM=1
