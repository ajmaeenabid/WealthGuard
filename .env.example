# Copy this file to .env and fill in your keys. .env is never committed

# Which provider answers
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Uncomment to force the offline mock (deterministic canned answers)
# USE_MOCK_LLM=1

# Vector database (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=wealthguard_kb

# Receipt signing key
RECEIPT_KEY=

# Speech to text
WHISPER_PROVIDER=
WHISPER_MODEL=

# ---- Personal finance assistant (uses GROQ_API_KEY above; the key never leaves the server)
FINANCE_MODEL=openai/gpt-oss-20b
# Request timeout in seconds, retries on 429/5xx/timeouts (exponential backoff with jitter, 
FIN_AI_TIMEOUT=30
FIN_AI_MAX_RETRIES=3
FIN_AI_CONCURRENCY=2
FIN_AI_RPM=20
FIN_AI_MAX_WAIT=20
# low (default), medium or high reasoning effort for gpt-oss
FIN_REASONING_EFFORT=low
# USD per million tokens used for the cost estimate (defaults are the Groq prices checked on
GROQ_PRICE_INPUT_PER_M=0.075
GROQ_PRICE_OUTPUT_PER_M=0.30
# Time zone for "today", "yesterday" and stored transaction dates (default Asia/Dhaka)
FIN_TZ=Asia/Dhaka

# ---- Storage, sign-in and startup validation ----
# WEALTHGUARD_DB=
# 0 switches sign-in OFF
# WEALTHGUARD_AUTH=1
# 1 stops the app reading this .env file (tests)
# WEALTHGUARD_NO_DOTENV=0
# 1 makes an invalid value above stop the server at startup (values are never printed)
# WEALTHGUARD_STRICT_CONFIG=0

# Prompt budget
# FIN_AI_MAX_INPUT_TOKENS=3500
# FIN_AI_MAX_OUTPUT_TOKENS=1200

# Hard time limits for one AI call (retries included), in seconds
# FIN_AI_DEADLINE=25
# WEALTHGUARD_LLM_DEADLINE=30

# Currency conversion uses real, free exchange-rate services (no key)
# FX_PROVIDER=auto        # "off" disables conversion (the assistant then asks for amounts in the account's own currency)
# FX_CACHE_HOURS=12
# FX_MAX_STALE_HOURS=72
# FX_TIMEOUT=6
